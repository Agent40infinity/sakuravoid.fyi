@inject IJSRuntime js

@if (!Empty)
{
    <div class="package-container">
        @if (!string.IsNullOrEmpty(Icon))
        { 
            <div class="package-icon-holder">
                <img src="@Icon" alt="@Icon" />
            </div>
        }
        <h3>@Name</h3>
        @if (!string.IsNullOrEmpty(Description))
        {
            <p class="package-description">@Description</p>
        }
        <div class="price-container">
            <p>@(String.IsNullOrEmpty(Price) ? "" : "$")@Price @Currency</p>
        </div>
        <a class="buy-button @(Sub ? "subscribe" : "")" @onclick=AddToCart>
            @if (!string.IsNullOrEmpty(Price))
            {
                @if (!Sub)
                {
                    <img src="../SVG/AddToCart.svg" />
                }
                <p>@(Sub ? "Subscribe" : "Buy")</p>
            } else
            {
                <p class="unavaliable">Unavaliable</p>
            }
        </a>
    </div>
}

@code {
    [Parameter]
    public string Icon { get; set; } = "";

    [Parameter]
    public string Name { get; set; } = "";

    [Parameter]
    public string Description { get; set; } = "";

    [Parameter]
    public string Price { get; set; } = "";

    [Parameter]
    public string Currency { get; set; } = "";

    [Parameter]
    public bool Empty { get; set; } = false;

    [Parameter]
    public bool Sub { get; set; } = false;

    [Parameter]
    public long PackageID { get; set; } = 0;

    // Call this dynamically when a user clicks "Buy" on Token, Contributor, or Patreon
    protected async Task AddToCart()
    {
        if (PackageID == 0)
        {
            return;    
        }

        var savedUser = await js.InvokeAsync<string>("localStorage.getItem", "sakuravoid_username");

        if (string.IsNullOrEmpty(savedUser))
        {
            return;
        }

        await js.InvokeVoidAsync("addPackageToBasket", PackageID);
    }
}