@inject IJSRuntime js

<div class="basket-container">
    @if (IsBasketOpen)
    {
        <div class="basket">
            <div class="basket-header">
                <h3>Your Basket</h3>
                <button class="basket-close" @onclick="ToggleBasket">×</button>
            </div>
            <div class="basket-list">
                @if (Tebex.Basket.Count == 0)
                {
                    <p class="basket-empty">Your basket is currently empty.</p>
                }
                else
                {
                    @foreach (var item in Tebex.Basket)
                    {
                        <div class="basket-item">
                            <div class="basket-item-info">
                                <span class="basket-item-name">@item.Name @(item.Quantity > 1 ? "(x" + @item.Quantity + ")" : "")</span>
                                <span class="basket-item-price">$@item.Price @item.Currency</span>
                            </div>
                            <a class="basket-item-remove" @onclick="() => Tebex.DecreaseQuantity(js, item.PackageId, item.Quantity)" title="Remove one">x</a>
                        </div>
                    }
                }
            </div>
            <div class="basket-footer">
                <div class="basket-total">
                    <span>Total:</span>
                    <span>$@Tebex.BasketTotal.ToString("F2") @(Tebex.Basket.FirstOrDefault()?.Currency ?? "USD")</span>
                </div>
                <button class="basket-checkout" @onclick="Checkout">
                    Checkout
                </button>
            </div>
        </div>
    }

    <div class="basket-toggle" @onclick="ToggleBasket">
        <img src="../SVG/Basket.svg" />
        @if (Tebex.TotalItemCount > 0)
        {
            <div class="basket-count">@Tebex.TotalItemCount</div>
        }
    </div>
</div>

@code
{
    private bool IsBasketOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await Tebex.RefreshBasket(js);
    }

    private async Task ToggleBasket()
    {
        IsBasketOpen = !IsBasketOpen;

        if (IsBasketOpen)
        {
            await Tebex.RefreshBasket(js);
        }
    }

    protected async Task Checkout()
    {
        await js.InvokeVoidAsync("launchCheckout");
    }
}