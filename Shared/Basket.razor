@inject IJSRuntime js

<div class="basket-container">
    @if (IsBasketOpen)
    {
        <div class="basket">
            <div class="basket-header">
                <h3>Your Basket</h3>
                <button class="basket-close" @onclick="ToggleBasket">×</button>
            </div>
            <div class="basket-list">
                @if (BasketItems.Count == 0)
                {
                    <p class="basket-empty">Your basket is currently empty.</p>
                }
                else
                {
                    @foreach (var item in BasketItems)
                    {
                        <div class="basket-item">
                            <div class="basket-item-info">
                                <span class="basket-item-name">@item.Name</span>
                                <span class="basket-item-price">$@item.Price @item.Currency</span>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="basket-footer">
                <div class="basket-total">
                    <span>Total:</span>
                    <span>$@BasketTotal.ToString("F2") USD</span>
                </div>
                <button class="basket-checkout" @onclick="Checkout">
                    Checkout
                </button>
            </div>
        </div>
    }

    <div class="basket-toggle" @onclick="ToggleBasket">
        <img src="../SVG/Basket.svg" />
        @if (BasketItems.Count > 0)
        {
            <div class="basket-count">@BasketItems.Count</div>
        }
    </div>
</div>

@code 
{
    public class BasketItemModel
    {
        public string Name { get; set; } = "";
        public string Price { get; set; } = "0.00";
        public string Currency { get; set; } = "USD";
    }

    public class TebexBasketResponseWrapper
    {
        public TebexBasketData data { get; set; } = new();
    }

    public class TebexBasketData
    {
        public List<TebexPackage> packages { get; set; } = new();
        public string currency { get; set; } = "USD";
    }

    public class TebexPackage
    {
        public string name { get; set; } = "";
        public TebexInBasket in_basket { get; set; } = new();
    }

    public class TebexInBasket
    {
        public int quantity { get; set; }
        public decimal price { get; set; }
    }

    private bool IsBasketOpen = false;
    private List<BasketItemModel> BasketItems = new();
    private decimal BasketTotal => BasketItems.Sum(i => decimal.TryParse(i.Price, out var p) ? p : 0m);

    protected override async Task OnInitializedAsync()
    {
        await RefreshBasket();
    }

    private async Task ToggleBasket()
    {
        IsBasketOpen = !IsBasketOpen;
        StateHasChanged();

        if (IsBasketOpen)
        {
            await RefreshBasket();
        }
    }

    private async Task RefreshBasket()
    {
        try
        {
            var responseWrapper = await js.InvokeAsync<TebexBasketResponseWrapper>("getBasketDetails");

            if (responseWrapper != null && responseWrapper.data != null && responseWrapper.data.packages != null)
            {
                BasketItems.Clear();
                string currencyCode = string.IsNullOrEmpty(responseWrapper.data.currency) ? "USD" : responseWrapper.data.currency;

                foreach (var pkg in responseWrapper.data.packages)
                {
                    int qty = pkg.in_basket?.quantity > 0 ? pkg.in_basket.quantity : 1;
                    decimal itemPrice = pkg.in_basket?.price ?? 0m;

                    for (int i = 0; i < qty; i++)
                    {
                        BasketItems.Add(new BasketItemModel
                        {
                            Name = pkg.name ?? "Unknown Package",
                            Price = itemPrice.ToString("F2"),
                            Currency = currencyCode
                        });
                    }
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine("Error refreshing basket: " + ex.Message);
        }
    }

    protected async Task Checkout()
    {
        await js.InvokeVoidAsync("launchCheckout");
    }
}