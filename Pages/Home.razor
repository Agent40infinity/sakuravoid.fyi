            <div class="login-popup">
                <h2>What's your Username?</h2>
                <p>Please enter your Minecraft username to continue, you won't be asked to login to Mojang, this is just to make sure your account exists</p>
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <p style="color: #ff6b6b; margin: 5px; font-weight: bold;">@ErrorMessage</p>
                }
                <div class="login-text-container">
                    <input type="text" @bind-value=Username @bind-value:event="oninput" @onkeyup="HandleKeyUp" />
                </div>
                <a class="continue-button" @onclick=FindAccount>
                    @(IsLoading ? "Checking..." : "Continue")
