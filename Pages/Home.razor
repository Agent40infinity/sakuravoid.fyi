@code {
    public string Username { get; set; } = "";
    public string ErrorMessage { get; set; } = "";
    public bool ShowLoginPopup { get; set; } = true;
    public bool IsLoading { get; set; } = false;
    public bool HoverLogout = false;

    public string LoggedInButton() => HoverLogout ? "../SVG/Logout.svg" : "https://minotar.net/avatar/" + Username + "/32";

    protected override async Task OnInitializedAsync()
    {
        var savedUser = await js.InvokeAsync<string>("localStorage.getItem", "sakuravoid_username");

        if (!string.IsNullOrEmpty(savedUser))
        {
            Username = savedUser;
            ShowLoginPopup = false;
        }

        await base.OnInitializedAsync();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FindAccount();
        }
    }

    protected async Task FindAccount()
    {
        if (string.IsNullOrWhiteSpace(Username))
        {
            ErrorMessage = "Please enter a username.";
            return;
        }

        string cleanUsername = Username.Trim();

        if (!System.Text.RegularExpressions.Regex.IsMatch(cleanUsername, "^[a-zA-Z0-9_]{3,16}$"))
        {
            ErrorMessage = "Invalid Minecraft username format.";
            return;
        }

        IsLoading = true;
        ErrorMessage = "";

        try
        {
            string verifiedName = cleanUsername;

            var response = await Http.GetAsync($"https://playerdb.co/api/player/minecraft/{cleanUsername}");
            var result = await response.Content.ReadFromJsonAsync<PlayerDbResponse>();
           
            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data?.Player == null)
            {
                IsLoading = false;
                ErrorMessage = "Minecraft account does not exist.";

                return;
            }

            verifiedName = result.Data.Player.Username;

            await js.InvokeVoidAsync("localStorage.setItem", "sakuravoid_username", verifiedName);
            Username = verifiedName;

            await js.InvokeVoidAsync("initializeTebexStoreSession");

            IsLoading = false;
            ShowLoginPopup = false;
        }
        catch (Exception ex)
        {
            IsLoading = false;
            Console.Error.WriteLine(ex);
            ErrorMessage = "Error with verification services, report to admin";
        }
    }

    protected async Task Logout()
    {
        await js.InvokeVoidAsync("localStorage.removeItem", "sakuravoid_username");
        Username = "";
        ShowLoginPopup = true;
    }
}