@code {
    public string Username { get; set; } = "";
    public string ErrorMessage { get; set; } = "";
    public bool ShowLoginPopup { get; set; } = true;
    public bool IsLoading { get; set; } = false;

    public class MojangProfile
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var savedUser = await js.InvokeAsync<string>("localStorage.getItem", "sakuravoid_username");
        if (!string.IsNullOrEmpty(savedUser))
        {
            Username = savedUser;
            ShowLoginPopup = false;
        }

        await base.OnInitializedAsync();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FindAccount();
        }
    }

    protected async Task FindAccount()
    {
        if (string.IsNullOrWhiteSpace(Username))
        {
            ErrorMessage = "Please enter a username.";
            return;
        }

        string cleanUsername = Username.Trim();
        if (!System.Text.RegularExpressions.Regex.IsMatch(cleanUsername, "^[a-zA-Z0-9_]{3,16}$"))
        {
            ErrorMessage = "Invalid Minecraft username format.";
            return;
        }

        IsLoading = true;
        ErrorMessage = "";

        try
        {
            // C# HttpClient call handles Mojang lookup seamlessly with zero browser CORS overhead
            string verifiedName = cleanUsername;
            var response = await Http.GetAsync($"https://api.mojang.com/users/profiles/minecraft/{cleanUsername}");

            if (response.IsSuccessStatusCode)
            {
                var profile = await response.Content.ReadFromJsonAsync<MojangProfile>();
                if (profile != null && !string.IsNullOrEmpty(profile.Name))
                {
                    verifiedName = profile.Name;
                }
            }
            else
            {
                IsLoading = false;
                ErrorMessage = "Minecraft account does not exist.";
                return;
            }

            // Save verified name to 'sakuravoid_username'
            await js.InvokeVoidAsync("localStorage.setItem", "sakuravoid_username", verifiedName);
            Username = verifiedName;

            // Trigger separate JavaScript Tebex Session Initialization & Auth
            await js.InvokeVoidAsync("initializeTebexStoreSession");

            IsLoading = false;
            ShowLoginPopup = false;
        }
        catch (Exception ex)
        {
            IsLoading = false;
            Console.Error.WriteLine(ex);
            ErrorMessage = "Error connecting to Mojang verification service.";
        }
    }

    protected async Task Logout()
    {
        await js.InvokeVoidAsync("localStorage.removeItem", "sakuravoid_username");
        Username = "";
        ShowLoginPopup = true;
    }

    protected async Task Checkout()
    {
        await js.InvokeVoidAsync("launchCheckout");
    }
}